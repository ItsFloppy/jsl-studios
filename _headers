# HTTP headers for Netlify and Cloudflare Pages (same syntax on both).
# Apache hosts use .htaccess instead; keep the two policies in step, and in step with the
# <meta http-equiv="Content-Security-Policy"> fallback in each page's <head> (which leaves
# out frame-ancestors and upgrade-insecure-requests: the first has no effect in a <meta>,
# the second would break previews served over plain HTTP).

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# HTML keeps the host's default (revalidate on every visit), so edits show up at once.
# CSS and JS are also versioned with ?v=… in the pages; bump it when they change.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
# Image names carry no content hash, so they are cached for a week rather than forever:
# give a replaced image a new file name if it must show up sooner.
/assets/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
