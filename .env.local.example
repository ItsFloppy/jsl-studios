# Copy to .env.local and fill in. Without NEXT_PUBLIC_SANITY_PROJECT_ID the site runs on
# the static content in lib/data.ts.

# Sanity project (sanity.io/manage). Public identifiers, also set on Netlify.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Editor token, for local scripts only (npm run seed). Never prefix it with NEXT_PUBLIC_
# and never set it on Netlify: the site itself only reads public content.
SANITY_API_TOKEN=
